const CACHE_NAME = "nexa-ai-v1";

self.addEventListener("install", (event) => {
    console.log("NEXA AI service worker installed");
    self.skipWaiting();
});

self.addEventListener("activate", (event) => {
    console.log("NEXA AI service worker activated");

    event.waitUntil(
        self.clients.claim()
    );
});

self.addEventListener("fetch", (event) => {
    // Let the browser handle network requests normally.
    // This avoids interfering with the NEXA AI API.
    event.respondWith(
        fetch(event.request).catch(() => {
            return caches.match(event.request);
        })
    );
});
